---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Asel Elektronik | Elektrik ve elektronik çözümleri",
  description =
    "Asel Elektronik; aydınlatma, kablolama, güvenlik, otomasyon ve güç ürünlerinde doğru çözümü sunar.",
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "https://www.asel-elektronik.com";
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const socialImage = new URL("/og-cover.svg", siteUrl).toString();

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: "Asel Elektronik",
      url: siteUrl,
      logo: new URL("/favicon.svg", siteUrl).toString(),
    },
    {
      "@type": "WebSite",
      name: "Asel Elektronik",
      url: siteUrl,
      inLanguage: "tr-TR",
    },
  ],
};
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b1220" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="tr" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content="Asel Elektronik" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">İçeriğe geç</a>
    <slot />
  </body>
</html>
