---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import CatalogView from "../../../../components/CatalogView.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import { categories, type Category } from "../../../../data/catalog";
import { products } from "../../../../data/products";

export function getStaticPaths() {
  const pageSize = 36;
  return categories.flatMap((category) => {
    const categoryProducts = products.filter((product) => product.categorySlug === category.slug);
    const totalPages = Math.ceil(categoryProducts.length / pageSize);
    return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => index + 2).map((page) => ({
      params: { slug: category.slug, page: String(page) },
      props: { category, page },
    }));
  });
}

interface Props { category: Category; page: number; }
const { category, page } = Astro.props;
const pageSize = 36;
const categoryProducts = products.filter((product) => product.categorySlug === category.slug);
const totalPages = Math.ceil(categoryProducts.length / pageSize);
const catalogProducts = categoryProducts.slice((page - 1) * pageSize, page * pageSize);
---

<BaseLayout title={`${category.title} · Sayfa ${page} | Asel Elektronik`} description={`${category.title} ürünleri ${page}. sayfa: katalog kodu, ölçü ve teknik detaylarıyla Asel Elektronik ürün kataloğu.`}>
  <SiteHeader />
  <main id="main-content">
    <section class="page-hero page-hero--dark"><div class="container page-hero-grid"><div><Breadcrumbs items={[{ label: "Çözümler", href: "/kategoriler/" }, { label: category.title, href: `/kategoriler/${category.slug}/` }, { label: `Sayfa ${page}` }]} /><span class="eyebrow">{category.eyebrow}</span><h1>{category.title}<br /><em>sayfa {page}.</em></h1><p>{category.intro}</p></div><div class="page-hero-stat"><strong>{catalogProducts.length}</strong><span>ürün<br />bu sayfada</span></div></div></section>
    <section class="section section--white"><div class="container"><div class="catalog-toolbar"><div><span class="eyebrow">{category.title}</span><h2>Seçili ürünler</h2></div><a class="text-link" href="/urunler/">Tüm kataloğa dön <span aria-hidden="true">→</span></a></div><CatalogView catalogProducts={catalogProducts} totalCount={categoryProducts.length} currentPage={page} totalPages={totalPages} paginationBase={`/kategoriler/${category.slug}`} /></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
