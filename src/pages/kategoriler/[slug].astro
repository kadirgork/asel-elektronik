---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ProductCard from "../../components/ProductCard.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { categories, type Category } from "../../data/catalog";
import { products } from "../../data/products";

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

interface Props { category: Category; }
const { category } = Astro.props;
const categoryProducts = products.filter((product) => product.categorySlug === category.slug);
---

<BaseLayout title={`${category.title} | Asel Elektronik`} description={`${category.title}: ${category.description} Asel Elektronik ürün kataloğunu inceleyin.`}>
  <SiteHeader />
  <main id="main-content">
    <section class="page-hero page-hero--dark"><div class="container page-hero-grid"><div><Breadcrumbs items={[{ label: "Çözümler", href: "/kategoriler/" }, { label: category.title }]} /><span class="eyebrow">{category.eyebrow}</span><h1>{category.title}<br /><em>çözümleri.</em></h1><p>{category.intro}</p></div><div class="page-hero-stat"><strong>{String(categoryProducts.length).padStart(2, "0")}</strong><span>ürün<br />detay sayfası</span></div></div></section>
    <section class="section section--white"><div class="container"><div class="catalog-toolbar"><div><span class="eyebrow">{category.title}</span><h2>Seçili ürünler</h2></div><a class="text-link" href="/urunler/">Tüm kataloğa dön <span aria-hidden="true">→</span></a></div>{categoryProducts.length ? <div class="product-grid product-grid--catalog">{categoryProducts.map((product, index) => <ProductCard product={product} eager={index < 2} />)}</div> : <div class="empty-state"><h3>Bu kategori için ürün listesi hazırlanıyor.</h3><p>Proje ihtiyacını paylaş, uygun ürün grubu için birlikte ilerleyelim.</p><a class="button" href="/iletisim/">Teklif iste <span aria-hidden="true">↗</span></a></div>}</div></section>
    <section class="section category-detail-band"><div class="container category-detail-grid"><div><span class="eyebrow">Doğru seçim için</span><h2>Ürün detaylarını ve teknik özellikleri birlikte değerlendirelim.</h2></div><div><p>Her uygulamanın ihtiyacı farklıdır. Montaj alanı, kullanım amacı ve teknik gereksinimlerini paylaşarak daha doğru bir ürün önerisi alabilirsin.</p><a class="button" href="/iletisim/">Proje danışmanlığı <span aria-hidden="true">↗</span></a></div></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
