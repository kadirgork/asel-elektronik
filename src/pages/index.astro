---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { categories } from "../data/catalog";
import { products } from "../data/products";

const featuredProducts = products.slice(0, 8);
const itemListData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Asel Elektronik öne çıkan ürünler",
  itemListElement: featuredProducts.map((product, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Product",
      name: product.title,
      brand: { "@type": "Brand", name: product.brand },
      category: product.category,
      image: new URL(product.image, Astro.site ?? "https://www.asel-elektronik.com").toString(),
      url: new URL(`/urunler/${product.slug}/`, Astro.site ?? "https://www.asel-elektronik.com").toString(),
    },
  })),
};
---

<BaseLayout
  title="Asel Elektronik | Elektrik ve elektronik çözümleri"
  description="Aydınlatma, kablolama, güvenlik, otomasyon ve güç ürünlerinde doğru çözüm. Asel Elektronik ile projen için güvenilir tedarik."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListData)} />
  </Fragment>

  <SiteHeader />

  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Elektrik & elektronik çözümleri</span>
          <h1 id="hero-title">Doğru ürün.<br /><em>Kesintisiz güç.</em></h1>
          <p class="hero-lead">
            Asel Elektronik, yaşam alanlarından endüstriyel projelere kadar ihtiyaç duyduğun elektrik ve elektronik ürünlerini anlaşılır, hızlı ve güvenilir bir deneyimle sunar.
          </p>
          <div class="hero-actions">
            <a class="button button--lime" href="/urunler/">Ürünleri keşfet <span aria-hidden="true">↓</span></a>
            <a class="button" href="/iletisim/">Teklif al <span aria-hidden="true">↗</span></a>
          </div>
          <p class="hero-note"><span aria-hidden="true"></span><strong>Proje odaklı tedarik</strong> · İhtiyacına uygun seçim</p>
        </div>

        <div class="hero-visual" aria-label="Asel Elektronik bağlantı ve güç görseli" role="img">
          <div class="hero-panel">
            <span class="panel-label">A / E · SYSTEM 01</span>
            <div class="panel-core"><span>AE</span></div>
            <div class="signal signal--one">Enerji hazır</div>
            <div class="signal signal--two">Güvenli bağlantı</div>
          </div>
          <div class="hero-orbit" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <section class="proof-strip" aria-label="Asel Elektronik ürün grupları">
      <div class="container proof-grid">
        <div class="proof-item"><span class="proof-index">01</span><p><strong>Aydınlatma</strong>Yaşam alanları ve işletmeler</p></div>
        <div class="proof-item"><span class="proof-index">02</span><p><strong>Şalt & otomasyon</strong>Kontrol ve koruma</p></div>
        <div class="proof-item"><span class="proof-index">03</span><p><strong>Kablolama</strong>Enerji ve veri altyapısı</p></div>
        <div class="proof-item"><span class="proof-index">04</span><p><strong>Güç</strong>Kesintisiz ve akıllı enerji</p></div>
      </div>
    </section>

    <section class="section section--white" id="cozumler" aria-labelledby="solutions-title">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow">İhtiyacın nerede?</span>
            <h2 id="solutions-title">Elektriğin olduğu her yerde, çözüm var.</h2>
          </div>
          <p>Doğru ürünü bulmayı kolaylaştıran sade bir ürün mimarisi. İhtiyacını seç, gerisini birlikte netleştirelim.</p>
        </div>

        <div class="category-grid">
          {categories.map((category, index) => (
            <a class="category-card" href={`/kategoriler/${category.slug}/`}>
              <span class="category-index">{String(index + 1).padStart(2, "0")}</span>
              <h3>{category.title}</h3>
              <p>{category.description}</p>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section products-section" id="urunler" aria-labelledby="products-title">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Seçili ürünler</span>
            <h2 id="products-title">İhtiyaç duyduğun ürün, doğru yerde.</h2>
          </div>
          <p>Ürün detaylarını, teknik özellikleri ve kullanım alanlarını inceleyerek daha bilinçli seçim yap.</p>
        </div>

        <div class="product-grid">
          {featuredProducts.map((product, index) => <ProductCard product={product} eager={index < 2} />)}
        </div>
        <div class="section-action"><a class="button" href="/urunler/">Tüm ürünleri gör <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="section dark-section" id="yaklasim" aria-labelledby="approach-title">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Asel yaklaşımı</span>
            <h2 id="approach-title">Sadece ürün değil, netlik de sunuyoruz.</h2>
          </div>
          <p>Teknik detayları anlaşılır hale getiriyor, projen için doğru ürün kararını hızlandırıyoruz.</p>
        </div>

        <div class="solution-grid">
          <article class="solution-card"><div class="solution-index">01 / Seçim</div><h3>İhtiyacı doğru tanımla</h3><p>Alan, kullanım amacı ve teknik gereksinime göre ürün grubunu netleştir.</p></article>
          <article class="solution-card"><div class="solution-index">02 / Tedarik</div><h3>Güvenilir ürüne ulaş</h3><p>Günlük kullanımdan proje ihtiyaçlarına kadar doğru ürünleri tek çatı altında topla.</p></article>
          <article class="solution-card"><div class="solution-index">03 / Destek</div><h3>Projene güvenle devam et</h3><p>Karar anında ihtiyaç duyduğun ürün bilgisini ve yönlendirmeyi yanında bul.</p></article>
        </div>
      </div>
    </section>

    <section class="section quote-section" id="iletisim" aria-labelledby="contact-title">
      <div class="container">
        <div class="quote-card">
          <div>
            <span class="eyebrow">Bir sonraki adım</span>
            <h2 id="contact-title">Projen için doğru bağlantıyı birlikte kuralım.</h2>
          </div>
          <a class="button" href="/iletisim/">İletişime geç <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
