---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ProductCard from "../../components/ProductCard.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { getCategory } from "../../data/catalog";
import { products, type Product } from "../../data/products";

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const category = getCategory(product.categorySlug);
const relatedProducts = products.filter((item) => item.slug !== product.slug && item.categorySlug === product.categorySlug).slice(0, 3);
const fallbackProducts = relatedProducts.length ? relatedProducts : products.filter((item) => item.slug !== product.slug).slice(0, 3);
const siteUrl = Astro.site ?? new URL("https://www.asel-elektronik.com");
const productUrl = new URL(`/urunler/${product.slug}/`, siteUrl).toString();
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.title,
  description: product.description,
  image: new URL(product.image, siteUrl).toString(),
  url: productUrl,
  brand: { "@type": "Brand", name: product.brand },
  category: product.category,
  sku: product.catalogCode ?? product.slug,
  mpn: product.catalogCode,
  color: product.color ?? undefined,
  additionalProperty: product.specs.map((spec) => ({
    "@type": "PropertyValue",
    name: spec.label,
    value: spec.value,
  })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Ürünler", item: new URL("/urunler/", siteUrl).toString() },
    { "@type": "ListItem", position: 2, name: category?.title ?? product.category, item: new URL(`/kategoriler/${product.categorySlug}/`, siteUrl).toString() },
    { "@type": "ListItem", position: 3, name: product.title, item: productUrl },
  ],
};
---

<BaseLayout title={`${product.title} | Asel Elektronik`} description={product.description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <SiteHeader />

  <main id="main-content">
    <section class="detail-hero">
      <div class="container">
        <Breadcrumbs items={[{ label: "Ürünler", href: "/urunler/" }, { label: category?.title ?? product.category, href: `/kategoriler/${product.categorySlug}/` }, { label: product.title }]} />
        <div class="detail-layout">
          <div class="detail-media">
            <span class="product-tag">{product.category}</span>
            <img src={product.image} alt={`${product.brand} ${product.title}`} width="900" height="900" fetchpriority="high" />
          </div>
          <div class="detail-copy">
            <div class="product-meta"><span>{product.brand}</span><span>{product.catalogCode ?? product.category}</span></div>
            <h1>{product.title}</h1>
            <p class="detail-lead">{product.description}</p>
            <div class="detail-facts">
              {product.catalogCode && <span><small>Katalog kodu</small><strong>{product.catalogCode}</strong></span>}
              {product.color && <span><small>Renk</small><strong>{product.color}</strong></span>}
              {product.catalogPage && <span><small>Kaynak</small><strong>PDF s. {product.catalogPage}</strong></span>}
            </div>
            <div class="detail-actions"><a class="button button--lime" href="/iletisim/">Teklif iste <span aria-hidden="true">↗</span></a><a class="button button--outline" href={`/kategoriler/${product.categorySlug}/`}>Kategoriyi gör</a></div>
            <p class="detail-note"><span aria-hidden="true">ⓘ</span> Teknik değerler ve güncel fiyat, stok/model ve uygulama koşullarına göre teklif aşamasında teyit edilir.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--white detail-information">
      <div class="container detail-information-grid">
        <div class="detail-main-column">
          <span class="eyebrow">Ürün detayları</span>
          <h2>İhtiyacını netleştir, doğru kararı ver.</h2>
          <p class="detail-long-copy">{product.description} Bu ürünün kullanım alanı, teknik özellikleri ve uygulama koşulları için proje gereksinimlerini birlikte değerlendirebiliriz. Katalog kodunu teklif talebine ekleyerek doğru ölçü ve renk varyantı için daha hızlı dönüş alabilirsin.</p>
          <div class="feature-block"><h3>Öne çıkan özellikler</h3><ul class="feature-list">{product.features.map((feature) => <li>{feature}</li>)}</ul></div>
          <div class="feature-block"><h3>Kullanım alanları</h3><div class="use-case-list">{product.useCases.map((useCase) => <span>{useCase}</span>)}</div></div>
        </div>
        <aside class="spec-card" aria-labelledby="spec-title"><span class="eyebrow">Teknik tablo</span><h2 id="spec-title">Özellikler</h2><dl>{product.specs.map((spec) => <div><dt>{spec.label}</dt><dd>{spec.value}</dd></div>)}</dl><a class="text-link" href="/iletisim/">Teknik danışmanlık iste <span aria-hidden="true">↗</span></a></aside>
      </div>
    </section>

    <section class="section related-section" aria-labelledby="related-title">
      <div class="container"><div class="section-heading"><div><span class="eyebrow">Bunlara da bak</span><h2 id="related-title">İlgili ürünler</h2></div><a class="text-link" href="/urunler/">Tüm ürünleri gör <span aria-hidden="true">→</span></a></div><div class="product-grid">{fallbackProducts.map((item) => <ProductCard product={item} />)}</div></div>
    </section>

    <section class="section quote-section"><div class="container"><div class="quote-card"><div><span class="eyebrow">Proje desteği</span><h2>Bu ürünün doğru versiyonunu birlikte seçelim.</h2></div><a class="button" href="/iletisim/">Bize ulaş <span aria-hidden="true">↗</span></a></div></div></section>
  </main>

  <SiteFooter />
</BaseLayout>
