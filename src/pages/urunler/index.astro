---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ProductCard from "../../components/ProductCard.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { categories } from "../../data/catalog";
import { products } from "../../data/products";

const itemListData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Asel Elektronik ürün kataloğu",
  itemListElement: products.map((product, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: new URL(`/urunler/${product.slug}/`, Astro.site ?? "https://www.asel-elektronik.com").toString(),
    item: {
      "@type": "Product",
      name: product.title,
      brand: { "@type": "Brand", name: product.brand },
      image: new URL(product.image, Astro.site ?? "https://www.asel-elektronik.com").toString(),
    },
  })),
};
---

<BaseLayout
  title="Ürünler | Asel Elektronik"
  description="Asel Elektronik ürün kataloğu: aydınlatma, anahtar-priz, kablolama, güvenlik, otomasyon ve güç ürünlerini inceleyin."
>
  <Fragment slot="head"><script is:inline type="application/ld+json" set:html={JSON.stringify(itemListData)} /></Fragment>
  <SiteHeader />

  <main id="main-content">
    <section class="page-hero page-hero--dark">
      <div class="container page-hero-grid">
        <div>
          <Breadcrumbs items={[{ label: "Ürünler" }]} />
          <span class="eyebrow">Ürün kataloğu</span>
          <h1>İhtiyacın için<br /><em>doğru ürün.</em></h1>
          <p>Ürünleri kategoriye göre keşfet, teknik detayları incele ve projen için teklif iste.</p>
        </div>
        <div class="page-hero-stat"><strong>{products.length}</strong><span>seçili ürün<br />detay sayfası</span></div>
      </div>
    </section>

    <section class="section section--white catalog-section">
      <div class="container">
        <div class="catalog-toolbar">
          <div><span class="eyebrow">Kategori seç</span><h2>Ürün grupları</h2></div>
          <p>Aradığın ürüne kategori üzerinden daha hızlı ulaş.</p>
        </div>
        <div class="category-filter" aria-label="Ürün kategorileri">
          <a class="category-filter-link is-active" href="/urunler/">Tümü <span>{products.length}</span></a>
          {categories.filter((category) => products.some((product) => product.categorySlug === category.slug)).map((category) => (
            <a class="category-filter-link" href={`/kategoriler/${category.slug}/`}>{category.title}<span>{products.filter((product) => product.categorySlug === category.slug).length}</span></a>
          ))}
        </div>

        <div class="product-grid product-grid--catalog">
          {products.map((product, index) => <ProductCard product={product} eager={index < 4} />)}
        </div>
      </div>
    </section>

    <section class="section quote-section" id="teklif">
      <div class="container"><div class="quote-card"><div><span class="eyebrow">Ürün seçimi</span><h2>Aradığın ürün listede yok mu?</h2></div><a class="button" href="/iletisim/">Bize danış <span aria-hidden="true">↗</span></a></div></div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
