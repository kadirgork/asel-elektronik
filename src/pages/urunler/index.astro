---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CatalogView from "../../components/CatalogView.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { products } from "../../data/products";

const pageSize = 36;
const catalogProducts = products.slice(0, pageSize);
const totalPages = Math.ceil(products.length / pageSize);
const itemListData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Asel Elektronik ürün kataloğu",
  numberOfItems: products.length,
  itemListElement: catalogProducts.map((product, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: new URL(`/urunler/${product.slug}/`, Astro.site ?? "https://www.asel-elektronik.com").toString(),
    item: {
      "@type": "Product",
      name: product.title,
      brand: { "@type": "Brand", name: product.brand },
      image: new URL(product.image, Astro.site ?? "https://www.asel-elektronik.com").toString(),
    },
  })),
};
---

<BaseLayout
  title="Ürünler | Asel Elektronik"
  description="Asel Elektronik ürün kataloğu: Mega Teknik, bimed, bimed A1Ex, iPEK ve mega kablo koruma, boru, rakor ve tesisat ürünlerini marka ve kategoriye göre inceleyin."
>
  <Fragment slot="head"><script is:inline type="application/ld+json" set:html={JSON.stringify(itemListData)} /></Fragment>
  <SiteHeader />

  <main id="main-content">
    <section class="page-hero page-hero--dark">
      <div class="container page-hero-grid">
        <div>
          <Breadcrumbs items={[{ label: "Ürünler" }]} />
          <span class="eyebrow">Ürün kataloğu</span>
          <h1>İhtiyacın için<br /><em>doğru ürün.</em></h1>
          <p>Ürünleri marka ve kategoriye göre keşfet, katalog kodunu ve teknik detayları incele, projen için teklif iste.</p>
        </div>
        <div class="page-hero-stat"><strong>{products.length}</strong><span>katalog ürünü<br />detay sayfası</span></div>
      </div>
    </section>

    <section class="section section--white catalog-section">
      <div class="container">
        <div class="catalog-toolbar">
          <div><span class="eyebrow">Katalog</span><h2>Ürün grupları</h2></div>
          <p>İlk sayfadan hızlıca başla; marka filtresi ve sayfalama ile katalogdaki tüm teknik seçeneklere ulaş.</p>
        </div>
        <CatalogView catalogProducts={catalogProducts} totalCount={products.length} totalPages={totalPages} />
      </div>
    </section>

    <section class="section quote-section" id="teklif">
      <div class="container"><div class="quote-card"><div><span class="eyebrow">Ürün seçimi</span><h2>Aradığın ürün listede yok mu?</h2></div><a class="button" href="/iletisim/">Bize danış <span aria-hidden="true">↗</span></a></div></div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
