---
import type { Product } from "../data/products";

interface Props {
  product: Product;
  eager?: boolean;
}

const { product, eager = false } = Astro.props;
---

<article class="product-card" data-product-card data-brand={product.brand} data-category={product.categorySlug} data-search={`${product.title} ${product.catalogCode ?? ""} ${product.color ?? ""}`}>
  <a class="product-image" href={`/urunler/${product.slug}/`} aria-label={`${product.title} detayını incele`}>
    <span class="product-tag">{product.category}</span>
    <img
      src={product.image}
      alt={`${product.brand ? `${product.brand} ` : ""}${product.title}`}
      width="640"
      height="640"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
  </a>
  <div class="product-copy">
    <div class="product-meta"><span>{product.brand || "Ürün"}</span><span>{product.catalogCode ?? product.category}</span></div>
    <h3><a href={`/urunler/${product.slug}/`}>{product.title}</a></h3>
    <p>{product.highlight}</p>
    {product.color && <span class="product-variant">Renk: {product.color}</span>}
    <div class="product-price"><span>Geçici katalog fiyatı</span><strong>{product.price ? `${product.price} TL` : "Teklif al"}</strong></div>
    <a class="product-link" href={`/urunler/${product.slug}/`}>Ürün detayını incele <span aria-hidden="true">→</span></a>
  </div>
</article>
